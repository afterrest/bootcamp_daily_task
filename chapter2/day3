def solution(n, costs):
    answer = 0
    maps = [[float('inf')]*n for _ in range(n)]
    for edge in costs:
        maps[edge[0]][edge[1]] = edge[2]
        maps[edge[1]][edge[0]] = edge[2]
    visit_nodes = [0]
    left_nodes = [i for i in range(1, n)]
    while left_nodes:
        min_edge = float('inf')
        target_node = 0
        for i in visit_nodes:
            for j in left_nodes:
                if maps[i][j] < min_edge:
                    min_edge = maps[i][j]
                    target_node = j
        visit_nodes.append(target_node)
        left_nodes.remove(target_node)
        answer+= min_edge
    
    
    return answer
